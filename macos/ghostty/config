# Ghostty — managed in ~/.dotfiles/macos/ghostty (symlinked by install.sh)
# https://ghostty.org/docs/config

# Muted dark palette (matches simple-bar dotfiles theme)
background = 1c1d21
foreground = c5c9d0
cursor-color = c5c9d0
selection-background = 2e3036
selection-foreground = dfe1e6

# Typography
font-family = JetBrains Mono
font-size = 13
font-thicken = true

# Window (opacity changes need a Ghostty restart on macOS)
window-padding-x = 8
window-padding-y = 8
window-decoration = true
macos-titlebar-style = hidden
macos-option-as-alt = true
background-opacity = 0.85
background-blur = 20
# Cursor
cursor-style = bar
cursor-style-blink = false

# Shell (login shell from chsh)
shell-integration-features = cursor,sudo,title

# Subtle palette for CLI tools
palette = 0=#141518
palette = 1=#b48a8e
palette = 2=#8f9f85
palette = 3=#a89f7a
palette = 4=#7d8fa8
palette = 5=#9a8fa8
