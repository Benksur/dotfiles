# Stone — monochrome grayscale (matches simple-bar / ghostty)
# main_bg empty = use terminal background (#0a0a0a in ghostty)
theme[main_bg]=""

theme[main_fg]="#b4bac4"
theme[title]="#f0f0f0"
theme[hi_fg]="#e8e8e8"

theme[selected_bg]="#484848"
theme[selected_fg]="#f0f0f0"
theme[inactive_fg]="#909090"
theme[graph_text]="#d8d8d8"

theme[meter_bg]="#141414"
theme[proc_misc]="#c8c8c8"

theme[cpu_box]="#909090"
theme[mem_box]="#a0a0a0"
theme[net_box]="#b0b0b0"
theme[proc_box]="#c0c0c0"

theme[div_line]="#141414"

theme[temp_start]="#606060"
theme[temp_mid]="#a0a0a0"
theme[temp_end]="#e8e8e8"

theme[cpu_start]="#606060"
theme[cpu_mid]="#a0a0a0"
theme[cpu_end]="#e8e8e8"

theme[free_start]="#505050"
theme[free_mid]="#909090"
theme[free_end]="#d0d0d0"

theme[cached_start]="#585858"
theme[cached_mid]="#989898"
theme[cached_end]="#d8d8d8"

theme[available_start]="#686868"
theme[available_mid]="#a8a8a8"
theme[available_end]="#e0e0e0"

theme[used_start]="#404040"
theme[used_mid]="#808080"
theme[used_end]="#f0f0f0"

theme[download_start]="#606060"
theme[download_mid]="#a0a0a0"
theme[download_end]="#e8e8e8"

theme[upload_start]="#707070"
theme[upload_mid]="#b0b0b0"
theme[upload_end]="#f0f0f0"

theme[process_start]="#707070"
theme[process_mid]="#b0b0b0"
theme[process_end]="#f0f0f0"
