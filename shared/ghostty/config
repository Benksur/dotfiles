# Ghostty — managed in ~/.dotfiles/shared/ghostty (symlinked by install.sh)
# https://ghostty.org/docs/config

# Dark cool grey (matches simple-bar Stone / zsh)
background = 0a0a0a
foreground = b4bac4
cursor-color = b4bac4
selection-background = 252830
selection-foreground = d8dce4

# Typography
font-family = JetBrains Mono
font-size = 13
font-thicken = true

# Window (opacity changes need a Ghostty restart on macOS)
window-padding-x = 8
window-padding-y = 8
window-decoration = true
macos-titlebar-style = hidden
macos-option-as-alt = true
background-opacity = 0.92
background-blur = 20

# Cursor
cursor-style = bar
cursor-style-blink = false

# Shell (login shell from chsh)
shell-integration-features = cursor,sudo,title

# Dark cool grey ANSI palette
palette = 0=#0c0d10
palette = 1=#a87080
palette = 2=#6d8a84
palette = 3=#949aa8
palette = 4=#6a85a8
palette = 5=#8480a0
palette = 6=#688a94
